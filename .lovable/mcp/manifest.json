{
  "version": 1,
  "sdk_version": "3.4.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ieevmvmmnfbbibpkiqhd.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "goal-to-done-compass",
      "version": "0.1.0",
      "title": "Goal To Done Compass"
    },
    "tools": [
      {
        "name": "list_goals",
        "title": "List goal projects",
        "description": "List your Ticklist goal projects with deadline, participants and progress.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_tasks",
        "title": "List tasks",
        "description": "List tasks across your goals (or one goal), open ones first by deadline. Use for 'what's my next task?'. Delayed = not done and deadline before today.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "goal_id": {
              "description": "Only tasks of this goal.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "assignee": {
              "description": "Only tasks assigned to this participant name.",
              "type": "string",
              "maxLength": 60
            },
            "include_done": {
              "description": "Include completed tasks (default false).",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "update_task",
        "title": "Update a task",
        "description": "Change a task's status (todo, in_progress, done), priority, deadline or assignee. Get task ids from list_tasks.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": true,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Task id."
            },
            "status": {
              "type": "string",
              "enum": [
                "todo",
                "in_progress",
                "done"
              ]
            },
            "priority": {
              "type": "string",
              "enum": [
                "high",
                "medium",
                "low"
              ]
            },
            "deadline": {
              "description": "YYYY-MM-DD",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "assignee": {
              "description": "Must be one of the goal's participant names.",
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          },
          "required": [
            "task_id"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "create_goal_plan",
        "title": "Split a goal into tasks",
        "description": "Create a new goal project; AI splits it into prioritized tasks with deadlines and gives each participant a role.",
        "annotations": {
          "readOnlyHint": false,
          "idempotentHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200,
              "description": "The goal, e.g. 'Build a portfolio website'."
            },
            "description": {
              "description": "What done looks like.",
              "type": "string",
              "maxLength": 2000
            },
            "deadline": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Goal deadline, YYYY-MM-DD."
            },
            "participants": {
              "description": "Participant names (default: ['Me']).",
              "minItems": 1,
              "maxItems": 12,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              }
            }
          },
          "required": [
            "title",
            "deadline"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
